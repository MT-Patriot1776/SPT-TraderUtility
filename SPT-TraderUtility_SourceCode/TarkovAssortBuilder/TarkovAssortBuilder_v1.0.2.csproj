
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <!-- Icon (must be .ico). Replace app.ico with your file -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Metadata -->
    <AssemblyName>TarkovAssortBuilder</AssemblyName>
    <RootNamespace>TarkovAssortBuilderLauncher</RootNamespace>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <Product>Tarkov Assort Builder</Product>
    <Company>MT_Militia</Company>
    <Description>Launcher that runs with native Windows PowerShell. No console window.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**;bin - Copy\**;obj\**;obj - Copy\**;**\* - Copy.cs" />
    <EmbeddedResource Remove="bin\**;bin - Copy\**;obj\**;obj - Copy\**" />
    <None Remove="bin\**;bin - Copy\**;obj\**;obj - Copy\**" />

    <!-- Embed the PowerShell script -->
    <EmbeddedResource Include="TarkovAssortBuilder_v15.ps1" />
  </ItemGroup>
</Project>
